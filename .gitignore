# ==========================================
# GENIO STRICT IGNORE (Minimalism Mode)
# ==========================================

# 1. Librairies & Environnements (RECURSIF)
**/venv/
**/.venv/
**/env/
**/__pycache__/
**/*.pyc
**/node_modules/
**/.env

# 2. Modeles IA & Poids lourds
**/*.pt
**/*.pth
**/*.bin
**/*.safetensors
**/*.gguf
**/*.onnx
**/models/
**/weights/
**/checkpoints/

# 3. Fichiers Medias, 3D & Datasets
**/*.wav
**/*.mp3
**/*.flac
**/*.mp4
**/*.glb
**/*.fbx
**/*.jsonl
**/*.csv
**/*.png
**/*.jpg

# 4. Caches, Logs & Workspace Local
**/.cache/
**/.pytest_cache/
**/*.log
**/.DS_Store
local_workspace/
tmp/
**/venv_voder/
venv_voder/

# 5. Secrets & credentials — JAMAIS committés (placeholders uniquement si requis
#    par un loader, avec valeur vide ; les vrais tokens vivent hors repo).
**/*TOKEN*.txt
**/*SECRET*.txt
**/*CREDENTIALS*.txt
**/*_KEY.txt
**/*.pem
**/*.key
.env.*

# Phase 30 : workdirs de session éphémères (tests/conteneurs)
state/session_workdirs/

# RC-fix CI : asset requis par le build (exception ciblée au ban **/*.png)
!genio_client/src/assets/mascot/mascot_cutout.png
!genio_client/src/assets/genio-avatar-face.png
!genio_client/src/assets/mascot/genio-hero.png
!/.env.example
