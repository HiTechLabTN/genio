# Genio — exemple de configuration (copier vers .env, valeurs factices)
# Ne jamais committer le vrai .env (gitignoré).

# Clé maîtresse API (OBLIGATOIRE si GENIO_ENV=prod ou GENIO_SECURITY_MODE=strict)
GENIO_API_KEY=

# Environnement : dev | prod
GENIO_ENV=dev

# Sécurité : development (défaut) | strict (fail-closed + clé exigée)
GENIO_SECURITY_MODE=development

# Sandbox : local (défaut) | container (Docker, quotas stricts)
GENIO_SANDBOX_MODE=local

# Cloud LLM : fermé par défaut ; "1" = opt-in explicite
GENIO_ALLOW_CLOUD=

# Modèle Ollama principal
GENIO_MODEL_PRIMARY=gemma4:12b
