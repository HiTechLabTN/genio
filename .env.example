# Genio — exemple de configuration (copier vers .env, valeurs factices)
# Ne jamais committer le vrai .env (gitignoré).

# Clé maîtresse API (OBLIGATOIRE si GENIO_ENV=prod ou GENIO_SECURITY_MODE=strict)
GENIO_API_KEY=

# Environnement : dev | prod
GENIO_ENV=dev

# Sécurité : development (défaut) | strict (fail-closed + clé exigée)
GENIO_SECURITY_MODE=development

# Sandbox : local (défaut) | container (Docker, quotas stricts)
GENIO_SANDBOX_MODE=local

# Cloud LLM : fermé par défaut ; "1" = opt-in explicite
GENIO_ALLOW_CLOUD=

# --- Ollama hybride pop-os (100.85.172.4:11434) + routeur :11435 ---
# L'IA est consommée depuis pop-os via Tailscale, pas en local.
GENIO_OLLAMA_BASE_URL=http://100.85.172.4:11434
GENIO_OLLAMA_ROUTER_URL=http://100.85.172.4:11435

# Modèles déjà installés sur pop-os (qwen3-vl:8b, qwen2.5-coder:14b-32k,
# gemma4:12b-32k, lfm3-omni:latest, genio-gesture:latest).
GENIO_OLLAMA_MODEL=qwen3-vl:8b
GENIO_OLLAMA_BACKUP_MODELS=qwen2.5-coder:14b-32k,lfm3-omni:latest,gemma4:12b-32k

# System Prompt "Jarvis Tounsi" (derja tunisienne + fr/en technique, drôle,
# proactif, efficace). Laissez vide pour utiliser la valeur par défaut de config.py.
GENIO_SYSTEM_PROMPT=

# Modèle Ollama principal (rétro-compat, priorité à GENIO_OLLAMA_MODEL)
GENIO_MODEL_PRIMARY=qwen3-vl:8b
