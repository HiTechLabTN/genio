#!/usr/bin/env python3
"""genio — smart installer CLI (stdlib only, deterministic exit codes)."""
import argparse
import json
import os
import sys

sys.path.insert(0, str(__import__("pathlib").Path(__file__).resolve().parents[1]))

from installer import INSTALLER_VERSION  # noqa: E402
from installer.core.errors import (  # noqa: E402
    EXIT_OK, EXIT_USER_ABORT, InstallerError,
    EXIT_ALREADY_INSTALLED, EXIT_AMBIGUOUS_INSTALLS,
)
from installer.core.paths import default_prefix, layout  # noqa: E402
from installer.core.runner import Runner  # noqa: E402


def _runner(prefix):
    return Runner(log_path=layout(prefix)["log"] if prefix else None)


def cmd_version(_args):
    print(f"genio installer {INSTALLER_VERSION}")
    return EXIT_OK


def cmd_install(args):
    from installer.detectors.system import detect_ports
    from installer.discovery import find as discovery
    from installer.core.paths import DEFAULT_PORTS
    from installer import i18n as _i18n
    from installer.flow import run_install as _assistant_flow
    from installer.flow import smoke as _smoke
    from installer.assistant import Assistant as _Assistant
    prefix = args.prefix or str(default_prefix())
    runner = _runner(prefix)
    from installer.core.events import Emitter
    emitter = Emitter(enabled=args.json_events)
    installs = discovery.discover(runner, prefix,
                                  extra_checkout=args.existing_checkout)
    plan = discovery.summarize(installs)
    _lang = _i18n.resolve_lang(getattr(args, "lang", None))
    _a = _Assistant(lang=_lang, interactive=False)
    if plan["action"] == "already-installed" and not args.prefix:
        if getattr(args, "assistant", False):
            print(_a.t("already_ok"))
        else:
            print(plan["message"])
        print(_a.t("refuse_second"))
        return EXIT_ALREADY_INSTALLED
    if plan["action"] == "repair-or-update" and not args.force:
        print(plan["message"])
        print(_a.t("refuse_overwrite"))
        if getattr(args, "assistant", False):
            print(_a.t("resume_found"))
        emitter.emit("USER_ACTION_REQUIRED", {"reason": plan["action"]})
        return EXIT_ALREADY_INSTALLED
    if plan["action"] == "reconcile" and not args.prefix and not args.yes:
        print(plan["message"])
        emitter.emit("USER_ACTION_REQUIRED", {"reason": plan["action"]})
        return EXIT_AMBIGUOUS_INSTALLS
    if args.check:
        print(plan["message"])
        return EXIT_OK
    if args.prefix and not args.force:
        from installer.core.manifest import read_manifest as _read_man
        _existing = _read_man(layout(prefix)["manifest"])
        if _existing is not None:
            if _existing.get("health") == "healthy":
                print(_a.t("already_ok"))
            else:
                print(_a.t("resume_found"))
            print(_a.t("refuse_overwrite"))
            return EXIT_ALREADY_INSTALLED
    emitter.emit("INSTALL_STARTED", {"prefix": prefix, "source": args.source})
    # Assistant preflight: TN report, explain, consent, repair, verify, retry.
    # Returns (exit_code, report); exit_code None means continue install.
    flow_rc, flow_rep = _assistant_flow(args, runner, prefix, emitter)
    if flow_rc is not None:
        return flow_rc
    ports = dict(DEFAULT_PORTS)
    if args.api_port:
        ports["api"] = args.api_port
    if args.web_port:
        ports["web"] = args.web_port
    for name, info in detect_ports(runner, ports).items():
        if not info["free"]:
            o = info["owner"]
            print(_a.t("port_busy", name=name, port=info["port"]) +
                  f" (pid={o.get('pid')} {o.get('process')} svc={o.get('service')})")
    if not args.yes and not args.check and not getattr(args, "assistant", False):
        emitter.emit("USER_ACTION_REQUIRED", {"reason": "confirm-install"})
        ans = input(f"Install Genio into {prefix}? [y/N] ")
        if ans.strip().lower() != "y":
            emitter.emit("INSTALL_FAILED", {}, error="INSTALL_CANCELLED")
            return EXIT_USER_ABORT
    if str(args.source).startswith(("http://", "https://")):
        emitter.emit("DOWNLOAD_STARTED", {"origin": args.source.split("/")[2]})
    from installer.installers import standalone
    try:
        import shutil as _sh
        _npm_ok = bool(_sh.which("npm") and _sh.which("node"))
        man = standalone.install(
            runner, prefix, args.source, args.version or "standalone",
            {"ports": ports, "api_key": args.api_key or "",
             "checksum": args.checksum or None,
             "force": args.force, "emitter": emitter,
             "npm_ok": _npm_ok})
    except InstallerError as e:
        print(f"INSTALL FAILED: {e} {e.hint}")
        emitter.emit("INSTALL_FAILED", {"detail": str(e)[:200]},
                     error=_code_for(e.code))
        return e.code
    emitter.emit("INSTALL_COMPLETED", {"installation_id": man["installation_id"],
                                       "commit": man["commit"]})
    print(f"Installed {man['installation_id'][:8]} commit={man['commit']} "
          f"frontend={man.get('_frontend', {}).get('status')}")
    if args.with_services:
        from installer.services import systemd
        lay = layout(prefix)
        try:
            text = systemd.unit_text(prefix, lay["repo"], lay["venv"],
                                     lay["env_file"], ports.get("api", 8000))
            dest = systemd.install_unit(runner, "genio-standalone.service", text)
            print(_a.t("service_installed", v=dest))
        except InstallerError as e:
            print(_a.t("service_skipped"), f"{e} {e.hint}")
    # First-run experience: real smoke test + first useful interaction.
    from installer.flow import smoke as _smoke2
    from installer.assistant import Assistant as _Assistant2
    _a2 = _Assistant2(lang=_lang, interactive=bool(getattr(args, "assistant", False)))
    _assistant_mode = bool(getattr(args, "assistant", False))
    print(_a2.t("smoke_start"))
    sm = _smoke2(prefix, runner, lang=_lang)
    smoke_ok = all(ok for _, ok, _ in sm)
    for name, ok, detail in sm:
        print(_a2.t("smoke_ok" if ok else "smoke_fail", detail=f"{name}: {detail}"))
    if _assistant_mode:
        print("")
        print(_a2.t("success_1"))
        print(_a2.t("success_2"))
        print(_a2.t("success_3"))
        print(_a2.t("start_cmd", cmd=_a2.t("start_cmd_real", prefix=prefix)))
        try:
            from installer.assistant import NeedInput as _Need
            choice = _a2.ask_choice(_a2.t("first_try"), [
                ("try", _a2.t("first_try_yes")), ("no", _a2.t("first_try_no"))])
        except _Need:
            choice = None
        if choice == "try":
            print(_a2.t("first_diag"))
            from installer import preflight as _pre
            rep = _pre.preflight(runner, prefix=prefix)
            for name in ("python3", "git", "pip", "venv", "docker"):
                it = rep["items"].get(name, {})
                mark = "✓" if it.get("state") == "AVAILABLE" else "⚠"
                print(f"{mark} {name}: {it.get('detail', '?')}")
            print(_a2.t("first_bye"))
    return EXIT_OK if smoke_ok else 17


def cmd_doctor(args):
    from installer.health import doctor as doc
    from installer import i18n as _i18n
    import sys as _sys
    lang = _i18n.resolve_lang(getattr(args, "lang", None))
    res = doc.doctor(_runner(args.prefix), prefix=args.prefix, deep=args.deep)
    smap = {"PASS": _i18n.t("doc_pass", lang), "WARN": _i18n.t("doc_warn", lang),
            "FAIL": _i18n.t("doc_fail", lang), "NOT_APPLICABLE": _i18n.t("doc_na", lang)}
    # --json stays machine-clean: human lines go to stderr, JSON to stdout.
    _human = _sys.stderr if args.json else None
    def _emit(text):
        print(text, file=_human) if _human else print(text)
    _emit(_i18n.t("doc_title", lang))
    for c in res["checks"]:
        _emit(f"[{smap.get(c['status'], c['status']):>14}] {c['name']}: {c['detail']}")
    verdict = _i18n.t("doc_healthy", lang) if not res["fail"] else _i18n.t("doc_attention", lang)
    _emit(f"{_i18n.t('doc_verdict', lang)} {verdict} ({res['fail']} FAIL)")
    if args.json:
        print(json.dumps(res, indent=2))
    return EXIT_OK if not res["fail"] else 17


def cmd_status(args):
    from installer.core.manifest import read_manifest
    from installer.discovery import find as discovery
    prefix = args.prefix or str(default_prefix())
    runner = _runner(prefix)
    installs = discovery.discover(runner, prefix)
    man = read_manifest(layout(prefix)["manifest"])
    if man:
        print(json.dumps({k: man.get(k) for k in
                          ("installation_id", "version", "commit", "install_root",
                           "install_mode", "health", "ports", "updated_at")}, indent=2))
    for i in installs:
        if i["kind"] != "prefix":
            print(f"[{i['kind']}] {i['location']} state={i['state']}")
    return EXIT_OK


def cmd_repair(args):
    from installer.repair.fix import diagnose, repair
    prefix = args.prefix or str(default_prefix())
    runner = _runner(prefix)
    print(f"diagnosis: {diagnose(prefix, runner)['state']}")
    try:
        res = repair(runner, prefix)
    except InstallerError as e:
        print(f"REPAIR FAILED: {e} {e.hint}")
        return e.code
    print(f"repaired: {res['fixed'] or 'nothing-to-fix'} (backup {res['backup']})")
    return EXIT_OK


def cmd_update(args):
    from installer.core.events import Emitter
    from installer.repair.fix import update
    prefix = args.prefix or str(default_prefix())
    emitter = Emitter(enabled=getattr(args, "json_events", False))
    try:
        res = update(_runner(prefix), prefix, ref=args.to or "HEAD",
                     archive=args.archive or None,
                     checksum=args.checksum or None,
                     allow_downgrade=args.allow_downgrade)
    except InstallerError as e:
        print(f"UPDATE FAILED (rolled back): {e} {e.hint}")
        emitter.emit("ROLLBACK_COMPLETED", {"after": "update-failure"})
        return e.code
    print(f"updated {res['old']} -> {res['new']}")
    return EXIT_OK


def cmd_rollback(args):
    from installer.core.events import Emitter
    from installer.repair.fix import rollback
    prefix = args.prefix or str(default_prefix())
    emitter = Emitter(enabled=getattr(args, "json_events", False))
    emitter.emit("ROLLBACK_STARTED", {"prefix": prefix})
    try:
        man = rollback(_runner(prefix), prefix, which=args.backup)
    except InstallerError as e:
        print(f"ROLLBACK FAILED: {e} {e.hint}")
        return e.code
    emitter.emit("ROLLBACK_COMPLETED", {"commit": man.get("commit")})
    print(f"rolled back, commit={man.get('commit')}")
    return EXIT_OK


def cmd_uninstall(args):
    import shutil
    from installer.core.manifest import read_manifest
    prefix = args.prefix or str(default_prefix())
    lay = layout(prefix)
    man = read_manifest(lay["manifest"])
    from installer import i18n as _i18n_u
    _lu = _i18n_u.resolve_lang(None)
    if man is None and not lay["prefix"].exists():
        print(_i18n_u.t("nothing_here", _lu))
        return EXIT_OK
    if not args.yes:
        from installer import i18n as _i18n_u2
        _lu2 = _i18n_u2.resolve_lang(None)
        if args.purge_data:
            # Données utilisateur : confirmation tapée, jamais un simple y/N.
            ans = input(_i18n_u2.t("uninstall_purge_ask", _lu2, p=prefix) + " ")
            if ans.strip() != "PURGE":
                return EXIT_USER_ABORT
        else:
            ans = input(_i18n_u2.t("uninstall_ask", _lu2, p=prefix) + " ")
            if ans.strip().lower() != "y":
                return EXIT_USER_ABORT
    elif args.purge_data:
        print(_i18n_u2.t("uninstall_purge_warn", _lu2, p=prefix))
    keep = []
    for child in lay["prefix"].iterdir():
        if child.name == "data" and not args.purge_data:
            keep.append(str(child))
            continue
        if child.is_dir() and not child.is_symlink():
            shutil.rmtree(child, ignore_errors=True)
        else:
            child.unlink(missing_ok=True)
    from installer import i18n as _i18n_u3
    print(_i18n_u3.t("uninstalled_ok", _i18n_u3.resolve_lang(None), p=prefix, k=keep or "nothing"))
    return EXIT_OK


def build_parser():
    p = argparse.ArgumentParser(prog="genio", description="Genio smart installer")
    sub = p.add_subparsers(dest="cmd", required=True)
    sub.add_parser("version").set_defaults(fn=cmd_version)
    i = sub.add_parser("install")
    i.add_argument("--prefix", default="")
    i.add_argument("--source", default="https://github.com/HiTechLabTN/genio.git")
    i.add_argument("--version", default="")
    i.add_argument("--yes", action="store_true")
    i.add_argument("--check", action="store_true")
    i.add_argument("--interactive", action="store_true")
    i.add_argument("--assistant", action="store_true",
                   help="Tunisian assistant experience (consent, repair, verify, retry)")
    i.add_argument("--dry-run", action="store_true",
                   help="plan + simulate privileged repairs without changing the system")
    i.add_argument("--lang", default="", choices=["", "tu", "fr", "en"],
                   help="installer language (default: Tunisian)")
    i.add_argument("--api-key", default="")
    i.add_argument("--checksum", default="")
    i.add_argument("--api-port", type=int, default=0)
    i.add_argument("--web-port", type=int, default=0)
    i.add_argument("--with-services", action="store_true")
    i.add_argument("--force", action="store_true")
    i.add_argument("--json-events", action="store_true")
    i.add_argument("--existing-checkout", default="")
    i.set_defaults(fn=cmd_install)
    d = sub.add_parser("doctor")
    d.add_argument("--prefix", default="")
    d.add_argument("--deep", action="store_true")
    d.add_argument("--json", action="store_true")
    d.add_argument("--lang", default="", choices=["", "tu", "fr", "en"])
    d.set_defaults(fn=cmd_doctor)
    s = sub.add_parser("status")
    s.add_argument("--prefix", default="")
    s.set_defaults(fn=cmd_status)
    for name, fn in (("repair", cmd_repair), ("update", cmd_update),
                     ("rollback", cmd_rollback), ("uninstall", cmd_uninstall)):
        q = sub.add_parser(name)
        q.add_argument("--prefix", default="")
        if name == "update":
            q.add_argument("--to", default="HEAD")
            q.add_argument("--archive", default="")
            q.add_argument("--checksum", default="")
            q.add_argument("--allow-downgrade", action="store_true")
            q.add_argument("--json-events", action="store_true")
        if name == "rollback":
            q.add_argument("--backup", default="")
            q.add_argument("--json-events", action="store_true")
        if name in ("uninstall",):
            q.add_argument("--yes", action="store_true")
            q.add_argument("--purge-data", action="store_true")
        q.set_defaults(fn=fn)
    return p


def _code_for(exit_code):
    from installer.core.errors import (
        EXIT_DEPS_MISSING, EXIT_DOWNLOAD_FAIL, EXIT_INTEGRITY_FAIL,
        EXIT_PERMISSION, EXIT_UNSUPPORTED, EXIT_VERIFY_FAIL)
    return {
        EXIT_DEPS_MISSING: "INSTALL_DEPS_MISSING",
        EXIT_DOWNLOAD_FAIL: "INSTALL_DOWNLOAD",
        EXIT_INTEGRITY_FAIL: "INSTALL_CHECKSUM",
        EXIT_VERIFY_FAIL: "INSTALL_VERIFY",
        EXIT_PERMISSION: "INSTALL_PERMISSION",
        EXIT_UNSUPPORTED: "INSTALL_UNSUPPORTED",
    }.get(exit_code, "INSTALL_VERIFY")


def main(argv=None):
    args = build_parser().parse_args(argv)
    try:
        return args.fn(args)
    except KeyboardInterrupt:
        # Real cancellation: no tmp litter, existing install preserved.
        import shutil
        from installer.core.paths import layout
        prefix = getattr(args, "prefix", "") or None
        if prefix:
            for tmpname in ("_archive_tmp", "_update_tmp"):
                shutil.rmtree(str(layout(prefix)["prefix"] / tmpname),
                              ignore_errors=True)
        print("CANCELLED by user — partial state left repairable, nothing deleted.")
        if getattr(args, "json_events", False):
            from installer.core.events import Emitter
            Emitter(enabled=True).emit("INSTALL_FAILED", {},
                                       error="INSTALL_CANCELLED")
        from installer.core.errors import EXIT_USER_ABORT
        return EXIT_USER_ABORT
    except InstallerError as e:
        print(f"ERROR: {e} {e.hint}")
        return e.code


if __name__ == "__main__":
    sys.exit(main())
