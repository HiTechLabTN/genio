 create mode 100644 genio_client/public/icon.png
 create mode 100644 genio_client/public/icons/favicon-32.png
 create mode 100644 genio_client/public/icons/icon-192.png
 create mode 100644 genio_client/public/icons/icon-512-maskable.png
