{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "updater:default",
    "updater:allow-check",
    "updater:allow-download-and-install",
    "process:default",
    "process:allow-restart",
    "shell:default",
    "shell:allow-open",
    "fs:default",
    "fs:allow-write",
    "fs:allow-read",
    "fs:allow-exists"
  ]
}
