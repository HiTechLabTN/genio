{
  "name": "genio-client",
  "private": true,
  "version": "2.3.5",
  "description": "Genio — Assistant IA intelligent avec Chronos Portal, Avatar 3D et multilingue (Darija/FR/EN)",
  "author": "HiTechLabTN <contact@hitechlab.tn>",
  "homepage": "https://github.com/HiTechLabTN/genio",
  "main": "electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "electron:start": "electron .",
    "electron:build:win": "electron-builder --win --x64 --publish never",
    "electron:build:linux": "electron-builder --linux --x64 --publish never",
    "capacitor:sync": "npx cap sync",
    "capacitor:build:android": "npx cap open android",
    "assets:generate": "capacitor-assets generate"
  },
  "dependencies": {
    "@capacitor/filesystem": "^5.2.2",
    "@mediapipe/face_mesh": "^0.4.1633559619",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-fs": "^2.5.2",
    "@tauri-apps/plugin-http": "^2.6.0",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-os": "^2.3.2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-shell": "^2.3.6",
    "@tauri-apps/plugin-updater": "^2.11.0",
    "@tauri-apps/plugin-upload": "^2.4.1",
    "@types/three": "^0.185.4",
    "electron-updater": "^6.3.9",
    "framer-motion": "^13.1.1",
    "lucide-react": "^1.37.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@capacitor/android": "^5.0.0",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^5.0.0",
    "@capacitor/ios": "^5.0.0",
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "autoprefixer": "^10.5.4",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.13",
    "typescript": "~5.8.3",
    "vite": "^7.0.4"
  },
  "build": {
    "appId": "com.hitechlab.genio",
    "productName": "Genio",
    "directories": {
      "output": "release-builds"
    },
    "publish": null,
    "win": {
      "target": "nsis",
      "icon": "public/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true
    },
    "linux": {
      "target": "deb",
      "icon": "public/icon.png",
      "category": "Utility"
    }
  }
}
